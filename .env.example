# Bu dosyayı .env.local olarak kopyala ve değerleri doldur.
# .env.local asla commit edilmez (.gitignore'da).

# ── Supabase ────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DİKKAT: Bu anahtar RLS'i tamamen bypass eder. Asla NEXT_PUBLIC_ yapma,
# asla tarayıcıya giden bir dosyadan import etme.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ───────────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Uygulama ────────────────────────────────────────────────────────────
# Yerelde http://localhost:3000, üretimde https://<projen>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kullanıcı başına günlük yükleme hakkı
DAILY_UPLOAD_LIMIT=3

# Tek Claude çağrısında üretilecek soru sayısı.
# Vercel Hobby (60sn limit) için 5. Pro plandaysan 10 veya 20 yapabilirsin.
QUESTION_BATCH_SIZE=5

# ── .env'e GİRMEYENLER ──────────────────────────────────────────────────
# Google OAuth Client ID/Secret buraya değil, Supabase Dashboard →
# Authentication → Providers → Google altına girilir.
# Google Cloud Console'da "Authorized redirect URI" olarak şunu tanımla:
#   https://<proje-ref>.supabase.co/auth/v1/callback
